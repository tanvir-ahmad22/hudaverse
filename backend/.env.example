# Backend runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database and existing auth token keys (provide locally; never commit secrets)
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email verification and password reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# OAuth remains unavailable until provider adapters are installed and configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# Phone OTP adapter settings; no SMS adapter is enabled by this implementation
SMS_PROVIDER=
SMS_ACCOUNT_ID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# WebAuthn/passkey deployment settings; no passkey adapter is enabled by this implementation
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=HudaVerse
WEBAUTHN_ORIGIN=
