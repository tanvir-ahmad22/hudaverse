# Backend runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
# Comma-separated additional origins; never use a wildcard with credentials.
ALLOWED_ORIGINS=
# Update when the approved Terms of Service change.
TERMS_VERSION=2026-11

# Database and existing auth token keys (provide locally; never commit secrets)
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email verification and password reset delivery
SMTP_HOST=
SMTP_PORT=587
# Set true for implicit TLS (usually port 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# OAuth provider credentials. Facebook callback is derived from API_BASE_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Facebook Login requires public_profile and email permissions.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# WebAuthn/passkey deployment settings; no passkey adapter is enabled by this implementation
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=HudaVerse
WEBAUTHN_ORIGIN=
